{
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  
"routes": [
    {
      "route": "/*",
      "redirect": "https://www.morethanmiles.co.in",
      "statusCode": 301,
      "conditions": {
        "host": ["morethanmiles.co.in"],
        "methods": ["GET", "HEAD"]
      }
    }
  ],
  "globalHeaders": {
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload"
  }
}
